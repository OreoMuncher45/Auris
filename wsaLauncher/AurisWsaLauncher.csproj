<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Auris</AssemblyName>
    <RootNamespace>AurisWsa</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>3.0.3</Version>
    <Product>Auris</Product>
    <AssemblyTitle>Auris</AssemblyTitle>
    <Description>Auris on Windows, through the Windows Subsystem for Android.</Description>
  </PropertyGroup>

  <!--
    The phone's app, the adb client and the icon all ride inside the executable, so the whole
    thing is one file: an Auris.exe somebody can copy to a Windows machine and run. The CI
    workflow puts the APK and adb.exe into Resources/ before it publishes.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\auris.apk" LogicalName="auris.apk" Condition="Exists('Resources\auris.apk')" />
    <EmbeddedResource Include="Resources\adb.exe" LogicalName="adb.exe" Condition="Exists('Resources\adb.exe')" />
    <EmbeddedResource Include="Resources\Auris.ico" LogicalName="Auris.ico" />
  </ItemGroup>

</Project>
